---
import { Plus } from '@lucide/astro';
import { faqs, company } from '../../data/site';
---
<section class="py-24 md:py-36">
  <div class="container-x grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow" data-reveal>Veelgestelde vragen</p>
      <h2 data-split class="mt-5 text-[clamp(2.2rem,4.6vw,4rem)] font-bold">Goed om te weten.</h2>
      <p data-reveal class="mt-6 text-lg text-muted">
        Staat uw vraag er niet bij? Bel ons op <a href={company.phoneHref} class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">{company.phone}</a>.
      </p>
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      {faqs.map((f) => (
        <details data-reveal class="faq group border-b border-ink/10">
          <summary class="flex list-none items-center justify-between gap-6 py-7 text-left font-display text-xl font-semibold md:text-2xl [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid size-11 shrink-0 place-items-center rounded-full border border-ink/15 transition-[transform,background-color,color] duration-500 ease-[var(--ease-out-expo)] group-open:rotate-45 group-open:bg-gold group-open:border-gold">
              <Plus class="size-5" aria-hidden="true" />
            </span>
          </summary>
          <p class="max-w-2xl pb-8 pr-16 text-lg text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { interpolate-size: allow-keywords; }
  .faq::details-content {
    block-size: 0;
    overflow: clip;
    transition: block-size 0.5s cubic-bezier(0.16, 1, 0.3, 1), content-visibility 0.5s allow-discrete;
  }
  .faq[open]::details-content { block-size: auto; }
</style>
