---
import { ArrowRight } from '@lucide/astro';
import { process } from '../../data/site';
---
<section id="werkwijze" data-hscroll class="relative overflow-hidden py-24 lg:h-screen lg:py-0">
  <div data-hscroll-track class="flex flex-col gap-6 lg:h-full lg:w-max lg:flex-row lg:items-center lg:gap-8 lg:pl-[max(3rem,calc((100vw-88rem)/2+3rem))] lg:pr-[10vw]">
    <div class="container-x lg:w-[34rem] lg:max-w-none lg:shrink-0 lg:px-0">
      <p class="eyebrow" data-reveal>Werkwijze</p>
      <h2 data-split class="mt-5 text-[clamp(2.2rem,4.6vw,4rem)] font-bold">In vijf heldere stappen naar het resultaat.</h2>
      <p data-reveal class="mt-6 max-w-md text-lg text-muted">Duidelijke afspraken vooraf, zodat u precies weet waar u aan toe bent.</p>
      <a data-reveal href="/offerte/" class="btn btn-dark mt-10">Start met stap 1 <ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>

    <ol class="container-x grid grid-cols-1 gap-4 lg:flex lg:w-auto lg:max-w-none lg:gap-8 lg:px-0">
      {process.map((step, i) => (
        <li data-reveal class="group relative flex flex-col justify-between overflow-hidden rounded-[2rem] border border-ink/10 bg-bone p-8 lg:h-[28rem] lg:w-[24rem] lg:shrink-0 lg:p-10 lg:even:mt-24">
          <span class="font-display text-[7rem] font-extrabold leading-none tracking-tighter text-gold/25 lg:text-[9rem]" aria-hidden="true">{i + 1}</span>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-gold-deep">Stap {i + 1}</p>
            <h3 class="mt-2 text-3xl font-semibold">{step.title}</h3>
            <p class="mt-3 text-muted">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="absolute inset-x-0 bottom-10 hidden lg:block" aria-hidden="true">
    <div class="container-x">
      <div class="h-[2px] w-full bg-ink/10">
        <div data-hscroll-progress class="h-full origin-left scale-x-0 bg-gold"></div>
      </div>
    </div>
  </div>
</section>
