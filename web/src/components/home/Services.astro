---
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import ServiceIcon from '../ServiceIcon.astro';
import { services } from '../../data/site';

interface Props { showAllLink?: boolean }
const { showAllLink = true } = Astro.props;
---
<section id="diensten" class="relative bg-sand/60 py-24 md:py-36">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal>Onze werkzaamheden</p>
        <h2 data-split class="mt-5 text-[clamp(2.2rem,4.6vw,4rem)] font-bold">Alles onder één dak, van kleine klus tot complete renovatie.</h2>
      </div>
      {showAllLink && <a data-reveal href="/diensten/" class="btn btn-ghost shrink-0">Alle diensten <ArrowRight class="size-4" aria-hidden="true" /></a>}
    </div>

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {services.map((s) => (
        <li data-reveal>
          <a
            href={`/diensten/${s.slug}/`}
            class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-ink/10 bg-bone p-7 transition-[transform,box-shadow,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:border-transparent hover:shadow-2xl hover:shadow-night/15"
          >
            <span class="absolute inset-0 -z-0 origin-bottom scale-y-0 bg-night transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-y-100" aria-hidden="true"></span>
            <span class="relative flex items-start justify-between">
              <span class="grid size-14 place-items-center rounded-2xl bg-gold/15 text-gold-deep transition-colors duration-500 group-hover:bg-gold group-hover:text-ink">
                <ServiceIcon name={s.icon} class="size-7" />
              </span>
            </span>
            <h3 class="relative mt-10 text-2xl font-semibold transition-colors duration-500 group-hover:text-bone">{s.title}</h3>
            <p class="relative mt-3 text-muted transition-colors duration-500 group-hover:text-bone/75">{s.short}</p>
            <span class="relative mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-bold text-gold-deep transition-colors duration-500 group-hover:text-gold-light">
              Meer info <ArrowUpRight class="size-4 transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
