---
import { Star } from '@lucide/astro';
import ReviewForm from '../ReviewForm.astro';
---
<section id="reviews" class="bg-sand/60 py-24 md:py-36">
  <div class="container-x grid grid-cols-1 gap-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow" data-reveal>Reviews</p>
      <h2 data-split class="mt-5 text-[clamp(2.2rem,4.6vw,4rem)] font-bold">Wat klanten over ons zeggen.</h2>

      <!-- Gemiddelde (verschijnt zodra er goedgekeurde reviews zijn) -->
      <div data-review-summary class="mt-8 hidden items-center gap-4">
        <p class="font-display text-6xl font-bold leading-none" data-avg></p>
        <div>
          <div class="flex text-gold" data-avg-stars aria-hidden="true"></div>
          <p class="mt-1 text-sm font-semibold text-muted" data-review-count></p>
        </div>
      </div>

      <ul data-review-list class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Klantreviews"></ul>

      <div data-review-empty class="mt-12 hidden rounded-3xl border-2 border-dashed border-ink/15 p-8">
        <p class="font-display text-2xl font-semibold">Nog geen reviews online</p>
        <p class="mt-2 text-muted">Heeft u met ons gewerkt? Wij horen graag hoe u het heeft ervaren. Uw review helpt anderen bij hun keuze.</p>
      </div>

      <template data-review-template>
        <li class="flex h-full flex-col rounded-3xl border border-ink/10 bg-bone p-7">
          <div class="flex gap-0.5 text-gold" data-stars></div>
          <p class="mt-4 flex-1 text-lg leading-relaxed text-ink-soft" data-message></p>
          <div class="mt-6 flex items-center gap-3 border-t border-ink/10 pt-5">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-night font-display font-bold text-gold-light" data-initials></span>
            <span>
              <span class="block font-semibold" data-name></span>
              <span class="block text-sm text-muted" data-meta></span>
            </span>
          </div>
        </li>
      </template>
      <template data-star-full><Star class="size-5 fill-current" stroke-width={0} /></template>
      <template data-star-empty><Star class="size-5 text-ink/15 fill-current" stroke-width={0} /></template>
    </div>

    <div class="lg:col-span-5">
      <div data-reveal class="rounded-[2rem] border border-ink/10 bg-white/70 p-6 shadow-2xl shadow-night/5 sm:p-10 lg:sticky lg:top-28">
        <h3 class="text-3xl font-semibold">Laat een review achter</h3>
        <p class="mt-2 mb-8 text-muted">Bedankt dat u de tijd neemt!</p>
        <ReviewForm />
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('reviews')!;
  const list = root.querySelector<HTMLUListElement>('[data-review-list]')!;
  const tpl = root.querySelector<HTMLTemplateElement>('[data-review-template]')!;
  const full = root.querySelector<HTMLTemplateElement>('[data-star-full]')!;
  const empty = root.querySelector<HTMLTemplateElement>('[data-star-empty]')!;

  const starRow = (target: Element, n: number) => {
    for (let i = 0; i < 5; i++) target.append((i < n ? full : empty).content.cloneNode(true));
  };
  const fmt = new Intl.DateTimeFormat('nl-NL', { month: 'long', year: 'numeric' });

  interface Review { name: string; stars: number; dienst?: string; message: string; createdAt: string }

  fetch('/api/reviews')
    .then((r) => r.json())
    .then((data: { reviews?: Review[] }) => {
      const reviews = data.reviews ?? [];
      if (!reviews.length) {
        root.querySelector('[data-review-empty]')!.classList.remove('hidden');
        return;
      }
      // Alles via textContent: invoer van bezoekers wordt nooit als HTML uitgevoerd
      reviews.forEach((r, i) => {
        const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        starRow(li.querySelector('[data-stars]')!, r.stars);
        li.querySelector('[data-stars]')!.setAttribute('aria-label', `${r.stars} van 5 sterren`);
        li.querySelector('[data-message]')!.textContent = `“${r.message}”`;
        li.querySelector('[data-name]')!.textContent = r.name;
        li.querySelector('[data-initials]')!.textContent = r.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
        li.querySelector('[data-meta]')!.textContent = [r.dienst, fmt.format(new Date(r.createdAt))].filter(Boolean).join(' · ');
        list.append(li);
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          li.animate([{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'none' }], { duration: 700, delay: i * 70, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'backwards' });
        }
      });
      const avg = reviews.reduce((s, r) => s + r.stars, 0) / reviews.length;
      const summary = root.querySelector('[data-review-summary]')!;
      summary.querySelector('[data-avg]')!.textContent = avg.toLocaleString('nl-NL', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
      starRow(summary.querySelector('[data-avg-stars]')!, Math.round(avg));
      summary.querySelector('[data-review-count]')!.textContent = `Gemiddeld uit ${reviews.length} ${reviews.length === 1 ? 'review' : 'reviews'}`;
      summary.classList.replace('hidden', 'flex');
    })
    .catch(() => root.querySelector('[data-review-empty]')!.classList.remove('hidden'));
</script>
