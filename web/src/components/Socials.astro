---
import { company } from '../data/site';

interface Props { class?: string; tone?: 'light' | 'dark' }
const { class: className, tone = 'light' } = Astro.props;

const icons = {
  instagram: { label: 'Instagram', path: 'M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zM12 0C8.7 0 8.3 0 7.1.1 2.7.3.3 2.7.1 7.1 0 8.3 0 8.7 0 12s0 3.7.1 4.9c.2 4.4 2.6 6.8 7 7C8.3 24 8.7 24 12 24s3.7 0 4.9-.1c4.4-.2 6.8-2.6 7-7 .1-1.2.1-1.6.1-4.9s0-3.7-.1-4.9c-.2-4.4-2.6-6.8-7-7C15.7 0 15.3 0 12 0zm0 5.8a6.2 6.2 0 1 0 0 12.4 6.2 6.2 0 0 0 0-12.4zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.8a1.4 1.4 0 1 0 0 2.9 1.4 1.4 0 0 0 0-2.9z' },
  facebook: { label: 'Facebook', path: 'M24 12.1C24 5.4 18.6 0 12 0S0 5.4 0 12.1c0 6 4.4 11 10.1 11.9v-8.4H7.1v-3.5h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9v2.3h3.4l-.5 3.5h-2.9V24C19.6 23.1 24 18.1 24 12.1z' },
  tiktok: { label: 'TikTok', path: 'M12.5 0h4c.3 2.3 1.6 4 4 4.5v4c-1.6 0-3-.4-4.1-1.2v7.7c0 4.7-4.6 8-9 6.6C3.1 20.1 1.4 15 4.6 11.7c1.5-1.5 3.5-2.2 5.6-1.9v4.1c-1.8-.6-3.6.7-3.6 2.5 0 2.3 2.6 3.6 4.4 2.3.8-.5 1.4-1.4 1.4-2.4V0z' },
} as const;

const items = (Object.keys(icons) as (keyof typeof icons)[])
  .filter((k) => company.socials[k])
  .map((k) => ({ ...icons[k], href: company.socials[k] }));
const style = tone === 'light'
  ? 'border-white/15 text-bone hover:bg-gold hover:border-gold hover:text-ink'
  : 'border-ink/15 text-ink hover:bg-ink hover:border-ink hover:text-bone';
---
<ul class:list={['flex gap-2', className]}>
  {items.map((s) => (
    <li>
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${company.name} op ${s.label}`} class:list={['grid size-11 place-items-center rounded-full border transition-colors duration-300', style]}>
        <svg viewBox="0 0 24 24" class="size-[18px] fill-current" aria-hidden="true"><path d={s.path} /></svg>
      </a>
    </li>
  ))}
</ul>
