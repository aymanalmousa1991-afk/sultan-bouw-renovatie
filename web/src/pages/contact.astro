---
import { Phone, Mail, MessageCircle, MapPin, Clock, ArrowRight, Check, FileDown } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Socials from '../components/Socials.astro';
import Honeypot from '../components/Honeypot.astro';
import { company } from '../data/site';

const channels = [
  { icon: Phone, label: 'Bellen', value: company.phone, href: company.phoneHref },
  { icon: MessageCircle, label: 'WhatsApp', value: 'Stuur een appje', href: company.whatsappHref, external: true },
  { icon: Mail, label: 'E-mail', value: company.email, href: `mailto:${company.email}` },
];
---
<Base title="Contact" description={`Neem contact op met ${company.name} in ${company.city}. Bel ${company.phone}, app ons of mail naar ${company.email}.`} darkTop>
  <PageHero eyebrow="Contact" title="Laten we kennismaken." intro="Een vraag, een idee of direct een afspraak? Neem op de manier die u het prettigst vindt contact met ons op." />

  <section class="py-24 md:py-32">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <ul class="space-y-3">
          {channels.map((c) => (
            <li data-reveal>
              <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined} class="group flex items-center gap-5 rounded-3xl border border-ink/10 bg-bone p-5 transition-[transform,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1 hover:shadow-xl hover:shadow-night/10">
                <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-gold/15 text-gold-deep transition-colors group-hover:bg-gold group-hover:text-ink"><c.icon class="size-6" aria-hidden="true" /></span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-muted">{c.label}</span>
                  <span class="block break-words font-display text-xl font-semibold">{c.value}</span>
                </span>
                <ArrowRight class="ml-auto size-5 shrink-0 text-ink/30 transition-[transform,color] group-hover:translate-x-1 group-hover:text-ink" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>

        <div data-reveal class="mt-10 grid gap-8 rounded-3xl bg-sand/70 p-8 sm:grid-cols-2">
          <div>
            <p class="flex items-center gap-2 font-semibold"><MapPin class="size-4 text-gold-deep" aria-hidden="true" />Vestiging</p>
            <p class="mt-2 text-muted">{company.city}<br />Actief in {company.region}</p>
          </div>
          <div>
            <p class="flex items-center gap-2 font-semibold"><Clock class="size-4 text-gold-deep" aria-hidden="true" />Bereikbaarheid</p>
            <ul class="mt-2 text-muted">
              {company.hours.map((h) => <li>{h.days}: {h.time}</li>)}
            </ul>
          </div>
          <div class="flex flex-wrap items-center justify-between gap-4 sm:col-span-2">
            <p class="text-sm text-muted">KvK {company.kvk}</p>
            <Socials tone="dark" />
          </div>
          <a href="/drukwerk/" class="btn btn-ghost sm:col-span-2"><FileDown class="size-4" aria-hidden="true" /> Bekijk flyer &amp; visitekaartje</a>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <div data-reveal class="rounded-[2rem] border border-ink/10 bg-white/60 p-6 shadow-2xl shadow-night/5 sm:p-10">
          <h2 class="text-3xl font-semibold">Stuur een bericht</h2>
          <p class="mt-2 text-muted">Voor een offerte kunt u ook ons <a href="/offerte/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">offerteformulier</a> gebruiken.</p>
          <form id="contact-form" novalidate class="relative mt-8 space-y-5">
            <Honeypot />
            <div>
              <label for="c-name" class="label">Naam <span class="text-gold-deep">*</span></label>
              <input id="c-name" name="name" required minlength="2" autocomplete="name" class="input" aria-describedby="c-name-error" />
              <p id="c-name-error" class="err hidden">Vul uw naam in.</p>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="c-email" class="label">E-mailadres</label>
                <input id="c-email" name="email" type="email" autocomplete="email" class="input" aria-describedby="c-contact-error" />
              </div>
              <div>
                <label for="c-phone" class="label">Telefoonnummer</label>
                <input id="c-phone" name="phone" type="tel" autocomplete="tel" class="input" aria-describedby="c-contact-error" />
              </div>
            </div>
            <p id="c-contact-error" class="err -mt-2 hidden">Vul een geldig e-mailadres of telefoonnummer in, zodat we u kunnen bereiken.</p>
            <div>
              <label for="c-message" class="label">Bericht <span class="text-gold-deep">*</span></label>
              <textarea id="c-message" name="message" required minlength="2" rows="5" class="input min-h-36 resize-y" aria-describedby="c-message-error"></textarea>
              <p id="c-message-error" class="err hidden">Schrijf een kort bericht.</p>
            </div>
            <label class="flex cursor-pointer items-start gap-3 text-sm text-muted">
              <input id="c-privacy" type="checkbox" class="mt-0.5 size-5 shrink-0 accent-[var(--color-gold)]" aria-describedby="c-privacy-error" />
              <span>Ik ga akkoord met de <a href="/privacy/" class="font-semibold text-ink underline">privacyverklaring</a>.</span>
            </label>
            <p id="c-privacy-error" class="err -mt-2 hidden">Ga akkoord met de privacyverklaring.</p>
            <button type="submit" class="btn btn-dark w-full">
              <span class="lbl">Verstuur bericht</span>
              <span class="ld hidden items-center gap-2"><span class="size-4 animate-spin rounded-full border-2 border-bone/30 border-t-bone"></span> Versturen…</span>
            </button>
            <div id="c-status" role="status" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .label { display: block; font-weight: 700; font-size: 0.95rem; margin-bottom: 0.5rem; }
  .input {
    display: block; width: 100%; min-height: 3.25rem; border-radius: 1rem;
    border: 2px solid rgb(17 21 19 / 0.12); background: var(--color-bone);
    padding: 0.8rem 1rem; font-size: 1rem; transition: border-color 0.3s, box-shadow 0.3s;
  }
  .input:hover { border-color: rgb(17 21 19 / 0.28); }
  .input:focus { outline: none; border-color: var(--color-gold); box-shadow: 0 0 0 4px rgb(181 136 73 / 0.18); }
  .input[aria-invalid='true'] { border-color: #b91c1c; }
  .err { margin-top: 0.4rem; font-size: 0.875rem; font-weight: 600; color: #b91c1c; }
</style>

<script>
  import { company } from '../data/site';
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('c-status')!;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

  function flag(input: HTMLElement | null, errId: string, bad: boolean) {
    input?.setAttribute('aria-invalid', String(bad));
    document.getElementById(errId)?.classList.toggle('hidden', !bad);
    return bad;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = $('c-name').value.trim();
    const email = $('c-email');
    const phone = $('c-phone').value.trim();
    const message = $('c-message').value.trim();
    const emailOk = !!email.value.trim() && email.checkValidity();
    const phoneOk = /^[0-9\s\-+()]{10,15}$/.test(phone);
    const bad = [
      flag($('c-name'), 'c-name-error', name.length < 2) && 'c-name',
      flag(email, 'c-contact-error', !emailOk && !phoneOk) && 'c-email',
      flag($('c-message'), 'c-message-error', message.length < 2) && 'c-message',
      flag($('c-privacy'), 'c-privacy-error', !$('c-privacy').checked) && 'c-privacy',
    ].filter(Boolean) as string[];
    if (bad.length) { $(bad[0]).focus(); return; }

    btn.disabled = true;
    btn.querySelector('.lbl')!.classList.add('hidden');
    btn.querySelector('.ld')!.classList.replace('hidden', 'inline-flex');
    status.innerHTML = '';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email: email.value.trim(), phone, message, website: (form.elements.namedItem('website') as HTMLInputElement).value }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.success) throw new Error();
      form.reset();
      status.className = 'rounded-2xl bg-night p-5 text-bone';
      status.textContent = 'Bedankt! Uw bericht is ontvangen. We nemen zo snel mogelijk contact met u op.';
    } catch {
      status.className = 'rounded-2xl bg-red-50 p-5 text-sm text-red-800';
      status.textContent = `Versturen is niet gelukt. Bel ons op ${company.phone} of mail naar ${company.email}.`;
    } finally {
      btn.disabled = false;
      btn.querySelector('.lbl')!.classList.remove('hidden');
      btn.querySelector('.ld')!.classList.replace('inline-flex', 'hidden');
    }
  });
</script>
