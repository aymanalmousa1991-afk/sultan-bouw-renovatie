---
import { Phone, Mail, MapPin, AtSign, Globe } from '@lucide/astro';
import Print from '../../../layouts/Print.astro';
import LogoStacked from '../../../assets/brand/logo-light.svg';
import Mark from '../../../assets/brand/mark-dark.svg';
import { company } from '../../../data/site';
import { qrSvg } from '../../../lib/qr';

// Visitekaartje 85 × 55 mm + 3 mm afloop rondom = 91 × 61 mm
const qr = await qrSvg(company.whatsappHref);
const insta = '@' + company.socials.instagram.replace(/\/$/, '').split('/').pop();
---
<Print title="Visitekaartje" width="91mm" height="61mm">
  <!-- Voorkant -->
  <section class="sheet bg-night text-bone">
    <div class="blueprint-grid absolute inset-0 opacity-70"></div>
    <div class="absolute inset-[6mm] flex flex-col items-center justify-center">
      <LogoStacked class="h-[27mm] w-auto" role="img" aria-label={company.name} />
    </div>
    <p class="absolute inset-x-0 bottom-[6.5mm] text-center text-[5.6pt] font-bold uppercase tracking-[0.32em] text-gold-light">
      Bouw &amp; Renovatie · {company.region}
    </p>
  </section>

  <!-- Achterkant -->
  <section class="sheet bg-bone text-ink">
    <div class="absolute bottom-0 left-0 top-0 w-[4.6mm] bg-gold"></div>
    <div class="absolute inset-y-[6mm] left-[10mm] right-[6mm] flex justify-between gap-[4mm]">
      <div class="flex min-w-0 flex-col">
        <p class="font-display text-[12.5pt] font-bold leading-none tracking-tight">{company.owner}</p>
        <p class="mt-[1.4mm] text-[5.8pt] font-bold uppercase tracking-[0.2em] text-gold-deep">Eigenaar · {company.name}</p>
        <ul class="mt-[4mm] space-y-[1.5mm] text-[6.8pt] leading-tight">
          <li class="flex items-center gap-[1.8mm]"><Phone class="size-[2.8mm] shrink-0 text-gold-deep" stroke-width={2.2} /><b>{company.phone}</b></li>
          <li class="flex items-center gap-[1.8mm]"><Mail class="size-[2.8mm] shrink-0 text-gold-deep" stroke-width={2.2} />{company.email}</li>
          <li class="flex items-center gap-[1.8mm]"><Globe class="size-[2.8mm] shrink-0 text-gold-deep" stroke-width={2.2} /><b>{company.website}</b></li>
          <li class="flex items-center gap-[1.8mm]"><AtSign class="size-[2.8mm] shrink-0 text-gold-deep" stroke-width={2.2} />{insta}</li>
          <li class="flex items-center gap-[1.8mm]"><MapPin class="size-[2.8mm] shrink-0 text-gold-deep" stroke-width={2.2} />{company.region}</li>
        </ul>
        <p class="mt-auto text-[5.2pt] text-muted">KvK {company.kvk}</p>
      </div>
      <div class="flex shrink-0 flex-col items-center justify-between">
        <Mark class="h-[8mm] w-auto" aria-hidden="true" />
        <div class="flex flex-col items-center">
          <div class="qr size-[17mm] rounded-[1.2mm] bg-white p-[1.2mm]" set:html={qr} />
          <p class="mt-[1.2mm] text-[5pt] font-bold uppercase tracking-[0.14em]">Scan &amp; app ons</p>
        </div>
      </div>
    </div>
  </section>
</Print>
