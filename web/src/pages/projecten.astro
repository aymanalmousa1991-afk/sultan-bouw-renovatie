---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects } from '../data/projects';
import { company } from '../data/site';
---
<Base title="Projecten" description={`Bekijk uitgevoerde projecten van ${company.name}: badkamers, tegelwerk, keukens, plafonds, vloeren, trappen, schilderwerk en buitenwerk.`} darkTop>
  <PageHero
    eyebrow="Projecten"
    title="Werk waar we trots op zijn."
    intro="Een overzicht van recente projecten in Amsterdam en omstreken. Klik op een foto om hem groot te bekijken."
  />
  <section class="py-20 md:py-28">
    <div class="container-x">
      <ProjectGallery items={projects} filter id="all" />
    </div>
  </section>
  <CtaBand title="Zo'n resultaat ook bij u thuis?" />
</Base>
